{
  "$id": "urn:outervoid:ca:result:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capability": {
      "type": "string"
    },
    "certified": {
      "const": false,
      "description": "cA never certifies its own work; DAT validates it."
    },
    "changeset": {
      "additionalProperties": false,
      "properties": {
        "base_tree": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "capability": {
          "maxLength": 64,
          "type": "string"
        },
        "changeset_id": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "contract": {
          "const": "ca.changeset"
        },
        "noop": {
          "type": "boolean"
        },
        "operations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "enum": [
                  "create",
                  "modify",
                  "delete"
                ]
              },
              "added": {
                "minimum": 0,
                "type": "integer"
              },
              "after": {
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "enum": [
                      "100644",
                      "100755",
                      null
                    ]
                  },
                  "sha256": {
                    "anyOf": [
                      {
                        "pattern": "^[0-9a-f]{64}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "sha256",
                  "mode"
                ],
                "type": "object"
              },
              "before": {
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "enum": [
                      "100644",
                      "100755",
                      null
                    ]
                  },
                  "sha256": {
                    "anyOf": [
                      {
                        "pattern": "^[0-9a-f]{64}$",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "sha256",
                  "mode"
                ],
                "type": "object"
              },
              "diff": {
                "maxLength": 8388608,
                "type": "string"
              },
              "path": {
                "description": "Workspace-relative path with forward slashes.",
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              "removed": {
                "minimum": 0,
                "type": "integer"
              },
              "sources": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "path",
              "action",
              "before",
              "after",
              "diff",
              "added",
              "removed",
              "sources"
            ],
            "type": "object"
          },
          "maxItems": 500,
          "type": "array"
        },
        "provenance": {
          "type": "object"
        },
        "stats": {
          "additionalProperties": false,
          "properties": {
            "created": {
              "minimum": 0,
              "type": "integer"
            },
            "deleted": {
              "minimum": 0,
              "type": "integer"
            },
            "files": {
              "minimum": 0,
              "type": "integer"
            },
            "lines_added": {
              "minimum": 0,
              "type": "integer"
            },
            "lines_removed": {
              "minimum": 0,
              "type": "integer"
            },
            "modified": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "files",
            "created",
            "modified",
            "deleted",
            "lines_added",
            "lines_removed"
          ],
          "type": "object"
        },
        "version": {
          "const": 1
        }
      },
      "required": [
        "contract",
        "version",
        "changeset_id",
        "capability",
        "base_tree",
        "provenance",
        "operations",
        "stats",
        "noop"
      ],
      "type": "object"
    },
    "construction": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "required": [
            "plan",
            "tasks",
            "unbuilt_tasks"
          ],
          "type": "object"
        }
      ]
    },
    "contract": {
      "const": "ca.result"
    },
    "dry_run": {
      "type": "boolean"
    },
    "engine": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "ca"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "code",
          "message",
          "refs"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "ledger": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "required": [
            "seq",
            "tree_before",
            "tree_after"
          ],
          "type": "object"
        }
      ]
    },
    "linkage": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "required": [
            "operation_id",
            "capability_id",
            "system"
          ],
          "type": "object"
        }
      ]
    },
    "repair": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "required": [
            "attempt",
            "max_attempts",
            "remaining_attempts",
            "report",
            "repaired",
            "unrepaired"
          ],
          "type": "object"
        }
      ]
    },
    "rollback": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "changeset_id": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "command": {
              "type": "string"
            }
          },
          "required": [
            "changeset_id",
            "command"
          ],
          "type": "object"
        }
      ]
    },
    "status": {
      "enum": [
        "applied",
        "dry-run",
        "noop"
      ]
    },
    "validation": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "dat"
        },
        "status": {
          "enum": [
            "required",
            "pending-apply",
            "unchanged"
          ]
        },
        "suggested": {
          "type": "object"
        }
      },
      "required": [
        "authority",
        "status",
        "suggested"
      ],
      "type": "object"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "contract",
    "version",
    "engine",
    "capability",
    "input_sha256",
    "status",
    "dry_run",
    "changeset",
    "ledger",
    "rollback",
    "findings",
    "repair",
    "construction",
    "certified",
    "validation",
    "linkage"
  ],
  "title": "ca.result v1",
  "type": "object"
}
