{
  "$id": "urn:outervoid:ca:artifact.repair:request:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Minimal, rule-specific fixes for DAT findings; bounded attempts; DAT must re-validate.",
  "properties": {
    "dry_run": {
      "description": "Compute the changeset without writing anything (default false).",
      "type": "boolean"
    },
    "instructions": {
      "items": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "content": {
                "maxLength": 1048576,
                "type": "string"
              },
              "executable": {
                "type": "boolean"
              },
              "expect_sha256": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "op": {
                "const": "create"
              },
              "path": {
                "description": "Workspace-relative path with forward slashes.",
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "op",
              "path",
              "content"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "content": {
                "maxLength": 1048576,
                "type": "string"
              },
              "executable": {
                "type": "boolean"
              },
              "expect_sha256": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "op": {
                "const": "write"
              },
              "path": {
                "description": "Workspace-relative path with forward slashes.",
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "op",
              "path",
              "content"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "count": {
                "maximum": 10000,
                "minimum": 1,
                "type": "integer"
              },
              "expect_sha256": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "new": {
                "maxLength": 1048576,
                "type": "string"
              },
              "old": {
                "maxLength": 1048576,
                "minLength": 1,
                "type": "string"
              },
              "op": {
                "const": "replace"
              },
              "path": {
                "description": "Workspace-relative path with forward slashes.",
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "op",
              "path",
              "old",
              "new"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "anchor": {
                "maxLength": 1048576,
                "minLength": 1,
                "type": "string"
              },
              "expect_sha256": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "op": {
                "const": "insert"
              },
              "path": {
                "description": "Workspace-relative path with forward slashes.",
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              "position": {
                "enum": [
                  "before",
                  "after"
                ]
              },
              "text": {
                "maxLength": 1048576,
                "type": "string"
              }
            },
            "required": [
              "op",
              "path",
              "anchor",
              "position",
              "text"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "expect_sha256": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "op": {
                "const": "append"
              },
              "path": {
                "description": "Workspace-relative path with forward slashes.",
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              "text": {
                "maxLength": 1048576,
                "type": "string"
              }
            },
            "required": [
              "op",
              "path",
              "text"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "expect_sha256": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "op": {
                "const": "prepend"
              },
              "path": {
                "description": "Workspace-relative path with forward slashes.",
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              },
              "text": {
                "maxLength": 1048576,
                "type": "string"
              }
            },
            "required": [
              "op",
              "path",
              "text"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "expect_sha256": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "op": {
                "const": "delete"
              },
              "path": {
                "description": "Workspace-relative path with forward slashes.",
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "op",
              "path"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "executable": {
                "type": "boolean"
              },
              "expect_sha256": {
                "anyOf": [
                  {
                    "pattern": "^[0-9a-f]{64}$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "op": {
                "const": "chmod"
              },
              "path": {
                "description": "Workspace-relative path with forward slashes.",
                "maxLength": 1024,
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "op",
              "path",
              "executable"
            ],
            "type": "object"
          }
        ]
      },
      "maxItems": 1000,
      "minItems": 1,
      "type": "array"
    },
    "max_attempts": {
      "description": "Repair attempts allowed after the last change (default 2).",
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
    },
    "report": {
      "description": "The dat.report DAT produced for this workspace.",
      "properties": {
        "contract": {
          "const": "dat.report"
        },
        "findings": {
          "items": {
            "properties": {
              "confidence": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "fingerprint": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "location": {
                "type": "object"
              },
              "rule_id": {
                "type": "string"
              },
              "severity": {
                "enum": [
                  "info",
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              }
            },
            "required": [
              "rule_id",
              "severity",
              "confidence",
              "fingerprint",
              "location"
            ],
            "type": "object"
          },
          "maxItems": 100000,
          "type": "array"
        },
        "gate": {
          "properties": {
            "fail_on": {
              "enum": [
                "info",
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "min_confidence": {
              "enum": [
                "low",
                "medium",
                "high"
              ]
            }
          },
          "required": [
            "fail_on",
            "min_confidence"
          ],
          "type": "object"
        },
        "outcome": {
          "type": "string"
        },
        "version": {
          "const": 1
        }
      },
      "required": [
        "contract",
        "version",
        "outcome",
        "gate",
        "findings"
      ],
      "type": "object"
    },
    "scope": {
      "description": "Findings to repair (default: those blocking the gate).",
      "enum": [
        "blocking",
        "all"
      ]
    },
    "workspace": {
      "description": "Workspace directory (relative to the caller's working directory).",
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "workspace",
    "report"
  ],
  "title": "artifact.repair request",
  "type": "object"
}
